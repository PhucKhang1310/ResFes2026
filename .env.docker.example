# Compose image and listener settings
RELEASE_TAG=local
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Use development for an HTTP localhost evaluation. Production requires HTTPS
# values below and enables secure cross-site cookies and trusted proxy handling.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
BACKEND_URL=http://localhost:8080
# External TLS proxy -> frontend Nginx -> Express is normally two hops.
TRUST_PROXY_HOPS=2
RELEASE_SHA=local

# Use URL-safe values because these credentials are embedded in MONGO_URI.
MONGO_ROOT_USERNAME=src2026
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password

# Generate independent values with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-32-character-secret
IDEMPOTENCY_SECRET=replace-with-a-different-32-character-secret
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
CRON_SECRET=replace-with-a-different-32-character-secret

# Cloudflare Turnstile. The site key is embedded in the frontend image.
VITE_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_EXPECTED_ACTION=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_TIMEOUT_MS=15000
IMAGE_MAX_DIMENSION=8000
IMAGE_MAX_PIXELS=25000000
MEDIA_ORPHAN_GRACE_MS=86400000
MEDIA_USAGE_RECHECK_MS=604800000

# Gmail SMTP notifications
GMAIL_USER=replace-with-smtp-user
GMAIL_APP_PASSWORD=replace-with-smtp-password
NOTIFY_EMAIL=replace-with-recipient
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=5
